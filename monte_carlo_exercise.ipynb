def estimate_pi(num_points):
    count_in_circle = 0
    for i in range(num_points):
        r = 0.5
        x = random.random()
        y = random.random()
        dis_to_center = ((x-r)**2+(y-r)**2)**(0.5)
        dis_to_center <= r
        if dis_to_center <= r:
           count_in_circle += 1
    pi = 4*count_in_circle/num_points
    return pi

pi = estimate_pi(100000)
pi
